{{!-- One story in the program. Featured posts run full width; so does the newest post on the home page (see .has-lead). --}}
<li class="card {{post_class}}{{#if featured}} is-wide{{/if}}">
    <a class="card-link" href="{{url}}">
        {{#if feature_image}}
            <div class="thumb">
                <img
                    srcset="{{img_url feature_image size="s"}} 480w, {{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 1600w"
                    sizes="{{#if featured}}(max-width: 760px) 92vw, 1272px{{else}}{{#if @first}}(max-width: 760px) 92vw, 1272px{{else}}(max-width: 760px) 92vw, (max-width: 1320px) 46vw, 620px{{/if}}{{/if}}"
                    src="{{img_url feature_image size="m"}}"
                    alt=""
                    loading="lazy">
            </div>
        {{else}}
            <div class="thumb thumb-card"><span data-detect-lang>{{excerpt characters="150"}}</span></div>
        {{/if}}
        <span class="card-meta">{{date format="DD MMM YYYY"}} · {{reading_time minute="1 min" minutes="% min"}}{{#has tag="#bilingual"}} · 雙語{{/has}}</span>
        <h3 class="card-title" data-detect-lang>{{title}}</h3>
        {{#if feature_image}}<p class="card-excerpt" data-detect-lang>{{excerpt characters="200"}}</p>{{/if}}
    </a>
</li>

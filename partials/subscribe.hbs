{{#if @site.members_enabled}}
    {{#unless @member}}{{#unless @site.members_invite_only}}
        <section class="subscribe" aria-labelledby="subscribe-title">
            <h2 id="subscribe-title">Get the next one by email</h2>
{{#if @site.paid_members_enabled}}<div>{{> signup class="pill" label="Subscribe"}}</div>{{else if @site.portal_signup_checkbox_required}}<div>{{> signup class="pill" label="Subscribe"}}</div>{{else if @site.allow_self_signup}}
            <div data-member-scope>
                <form class="subscribe-form" data-member-form="subscribe" novalidate>
                    <label class="sr-only" for="subscribe-email">Email</label>
                    <input id="subscribe-email" type="email" data-member-email placeholder="you@example.com" autocomplete="email" autocapitalize="off" spellcheck="false">
                    <button type="submit"><span class="go-idle">Subscribe</span><span class="go-busy">Sending…</span></button>
                </form>
                <p class="note note-success" aria-live="polite">Check <b data-member-echo></b> to confirm. 請到郵箱確認訂閱。</p>
                <p class="note note-error" data-member-error data-invalid="Enter a valid email address." data-fallback="That didn’t work. Try again." aria-live="assertive"></p>
            </div>
            {{else}}<div>{{> signup class="pill" label="Subscribe"}}</div>{{/if}}
        </section>
    {{/unless}}{{/unless}}
{{/if}}

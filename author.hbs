{{!< default}}
{{#author}}
<section class="title-card title-card-sm">
    <p class="label">Written by</p>
    <h1>{{name}}</h1>
    {{#if bio}}<p class="dek" data-detect-lang>{{bio}}</p>{{/if}}
</section>
{{/author}}
<section class="program" aria-label="Stories">
    <ol class="grid">
        {{#foreach posts}}
            {{> post-card}}
        {{/foreach}}
    </ol>
    {{pagination}}
</section>

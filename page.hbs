{{!< default}}
{{#post}}
<article class="{{post_class}}">
    {{#match @page.show_title_and_feature_image}}
    {{#if feature_image}}
        <figure class="screen feature">
            <div class="still">
                <img
                    srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 1600w, {{img_url feature_image size="xxl"}} 2400w"
                    sizes="100vw"
                    src="{{img_url feature_image size="xl"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                {{#if feature_image_caption}}
                    <figcaption class="subs"><span class="sub-second">{{feature_image_caption}}</span></figcaption>
                {{/if}}
            </div>
        </figure>
    {{/if}}
        <header class="post-head">
            <h1 class="post-title" data-detect-lang>{{title}}</h1>
            {{#if custom_excerpt}}<p class="dek" data-detect-lang>{{custom_excerpt}}</p>{{/if}}
        </header>
    {{/match}}
    <section class="gh-content">
        {{content}}
    </section>
</article>
{{/post}}
